# Ignore Visual Studio temporary files, build results, and
# user-specific files
## Ignore Visual Studio temporary files, build results, and user-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/

# Visual Studio Code
.vscode/

# Rider
.idea/

