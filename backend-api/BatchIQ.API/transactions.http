### Transaction API Tests

@baseUrl = https://localhost:7071/api

### Get all transactions
GET {{baseUrl}}/transactions

### Get specific transaction by ID
GET {{baseUrl}}/transactions/1

### Create a new transaction (Stock In) with notes and batch info
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "productId": 1,
  "fromLocationId": null,
  "toLocationId": 1,
  "quantity": 100,
  "unit": 1,
  "transactionType": 1,
  "expiryDate": "2025-12-31T00:00:00",
  "batchNumber": "BATCH-2025-001",
  "notes": "Initial stock received from supplier ABC",
  "unitCost": 15.50
}

### Create a transfer transaction with notes
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "productId": 1,
  "fromLocationId": 1,
  "toLocationId": 2,
  "quantity": 50,
  "unit": 1,
  "transactionType": 3,
  "expiryDate": "2025-12-31T00:00:00",
  "batchNumber": "BATCH-2025-001",
  "notes": "Transfer to main warehouse for distribution",
  "unitCost": null
}

### Create a stock out transaction (Sale) with sale notes
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "productId": 1,
  "fromLocationId": 1,
  "toLocationId": null,
  "quantity": 25,
  "unit": 1,
  "transactionType": 2,
  "expiryDate": null,
  "batchNumber": "BATCH-2025-001",
  "notes": "Sold to customer XYZ - Order #12345",
  "unitCost": null
}

### Update a transaction with notes
PUT {{baseUrl}}/transactions/1
Content-Type: application/json

{
  "productId": 1,
  "fromLocationId": 1,
  "toLocationId": 2,
  "quantity": 75,
  "unit": 1,
  "transactionType": 3,
  "expiryDate": "2025-11-30T00:00:00",
  "batchNumber": "BATCH-2025-001-UPDATED",
  "notes": "Updated: Transfer quantity adjusted due to quality check",
  "unitCost": 16.00
}

### Delete a transaction
DELETE {{baseUrl}}/transactions/3

### Test creating transaction with invalid product
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "productId": 999,
  "fromLocationId": 1,
  "toLocationId": 2,
  "quantity": 10,
  "unit": 1,
  "transactionType": 3,
  "expiryDate": null
}

### Test creating transaction with invalid location
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "productId": 1,
  "fromLocationId": 999,
  "toLocationId": 1,
  "quantity": 10,
  "unit": 1,
  "transactionType": 3,
  "expiryDate": null
}

### Test creating transaction with negative quantity
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "productId": 1,
  "fromLocationId": 1,
  "toLocationId": 2,
  "quantity": -10,
  "unit": 1,
  "transactionType": 3,
  "expiryDate": null
}
